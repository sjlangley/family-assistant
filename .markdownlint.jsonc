{
  // 100 to match .mdformat.toml's wrap. Tables and code blocks can't be
  // rewrapped, so they're exempt.
  "MD013": { "line_length": 100, "tables": false, "code_blocks": false },
  // Repeated headings are fine under different parents (e.g. "Testing" under
  // both the backend and frontend sections); only siblings must be unique.
  "MD024": { "siblings_only": true },
  "MD033": false, // inline HTML is fine
  "MD041": false // first line need not be a top-level heading
}
